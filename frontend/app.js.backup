class TahlilApp {
    constructor() {
        this.currentChatId = null;
        this.chats = [];
        this.uploadedFiles = [];
        this.selectedModel = 'gemini-2.5-flash';
        this.activeRun = null;
        this.refreshInterval = null;
        this.pollInterval = null; // Store poll interval for cancellation
        this.renderScheduled = false; // Flag to prevent multiple render calls
        this.init();
    }

    init() {
        // Load theme preference
        this.loadTheme();
        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
            const currentMode = localStorage.getItem('themeMode') || 'system';
            if (currentMode === 'system') {
                this.setThemeMode('system');
            }
        });
        // Load sidebar state
        this.loadSidebarState();
        // Setup event listeners
        this.setupEventListeners();
        this.loadChats();
        // Only create new chat if no chats exist
        if (this.chats.length === 0) {
            this.startNewChat();
        } else {
            // Load the most recent chat
            const mostRecent = this.chats[this.chats.length - 1];
            this.loadChat(mostRecent.id);
        }
    }

    setupEventListeners() {
        // File upload
        const fileUploadBtn = document.getElementById('fileUploadBtn');
        const fileInput = document.getElementById('fileInput');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');

        if (!fileUploadBtn || !fileInput || !messageInput || !sendBtn) {
            console.error('Required DOM elements not found');
            return;
        }

        fileUploadBtn.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => this.handleFileSelect(e));

        // Send message
        sendBtn.addEventListener('click', () => this.sendMessage());
        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                this.sendMessage();
            }
        });

        // Auto-resize textarea
        messageInput.addEventListener('input', () => {
            messageInput.style.height = 'auto';
            messageInput.style.height = Math.min(messageInput.scrollHeight, 200) + 'px';
        });

        // Custom Model Selection Dropdown
        this.initCustomSelect();
    }

    initCustomSelect() {
        // Initialize sidebar model select
        this.setupCustomSelect('modelSelectWrapper', 'modelSelectTrigger', 'modelSelectOptions', 'modelSelect', true);
        
        // Initialize settings model select
        this.setupCustomSelect('settingsModelSelectWrapper', 'settingsModelSelectTrigger', 'settingsModelSelectOptions', 'settingsModelSelect', false);

        // Sync UI with the current selectedModel value
        this.syncModelSelects(this.selectedModel);

        // Close all dropdowns on outside click
        document.addEventListener('click', (e) => {
            document.querySelectorAll('.custom-select.open').forEach(select => {
                if (!select.contains(e.target)) {
                    select.classList.remove('open');
                }
            });
        });

        // Close all dropdowns on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.custom-select.open').forEach(select => {
                    select.classList.remove('open');
                });
            }
        });
    }

    setupCustomSelect(wrapperId, triggerId, optionsId, inputId, syncToModel) {
        const wrapper = document.getElementById(wrapperId);
        const trigger = document.getElementById(triggerId);
        const options = document.getElementById(optionsId);
        const hiddenInput = document.getElementById(inputId);

        if (!wrapper || !trigger || !options || !hiddenInput) return;

        // Toggle dropdown
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            // Close other dropdowns first
            document.querySelectorAll('.custom-select.open').forEach(select => {
                if (select !== wrapper) select.classList.remove('open');
            });
            wrapper.classList.toggle('open');
        });

        // Handle option selection
        options.addEventListener('click', (e) => {
            const option = e.target.closest('.custom-select-option');
            if (!option) return;

            // Update selected state
            options.querySelectorAll('.custom-select-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            option.classList.add('selected');

            // Update trigger text and hidden input
            const value = option.dataset.value;
            const text = option.textContent.replace(' (Recommended)', '');
            trigger.querySelector('.custom-select-value').textContent = text;
            hiddenInput.value = value;
            
            if (syncToModel) {
                this.selectedModel = value;
            }

            // Sync both dropdowns
            this.syncModelSelects(value);

            // Close dropdown
            wrapper.classList.remove('open');
        });
    }

    syncModelSelects(value) {
        // Sync sidebar dropdown
        const sidebarTrigger = document.getElementById('modelSelectTrigger');
        const sidebarOptions = document.getElementById('modelSelectOptions');
        const sidebarInput = document.getElementById('modelSelect');
        
        // Sync settings dropdown
        const settingsTrigger = document.getElementById('settingsModelSelectTrigger');
        const settingsOptions = document.getElementById('settingsModelSelectOptions');
        const settingsInput = document.getElementById('settingsModelSelect');

        // Get display text
        const displayText = this.getModelDisplayName(value);

        // Update sidebar
        if (sidebarTrigger && sidebarOptions && sidebarInput) {
            sidebarTrigger.querySelector('.custom-select-value').textContent = displayText;
            sidebarInput.value = value;
            sidebarOptions.querySelectorAll('.custom-select-option').forEach(opt => {
                opt.classList.toggle('selected', opt.dataset.value === value);
            });
        }

        // Update settings
        if (settingsTrigger && settingsOptions && settingsInput) {
            settingsTrigger.querySelector('.custom-select-value').textContent = displayText;
            settingsInput.value = value;
            settingsOptions.querySelectorAll('.custom-select-option').forEach(opt => {
                opt.classList.toggle('selected', opt.dataset.value === value);
            });
        }

        this.selectedModel = value;
    }

    getModelDisplayName(value) {
        const names = {
            'gemini-2.5-flash': 'Gemini 2.5 Flash',
            'gemini-2.0-flash': 'Gemini 2.0 Flash',
            'gpt-4': 'GPT-4',
            'gpt-4-turbo': 'GPT-4 Turbo'
        };
        return names[value] || value;
    }

    loadChats() {
        // Load chat history from localStorage
        const saved = localStorage.getItem('tahlilChats');
        this.chats = saved ? JSON.parse(saved) : [];
        // Clean up empty chats (keep at least one if all are empty)
        this.cleanupEmptyChats();
        this.renderChatHistory();
    }

    cleanupEmptyChats() {
        // Remove empty chats, but keep at least one
        const nonEmptyChats = this.chats.filter(chat => chat.messages && chat.messages.length > 0);
        if (nonEmptyChats.length > 0) {
            this.chats = nonEmptyChats;
        } else if (this.chats.length > 1) {
            // If all are empty, keep only the most recent one
            this.chats = [this.chats[this.chats.length - 1]];
        }
    }

    saveChats() {
        localStorage.setItem('tahlilChats', JSON.stringify(this.chats));
        this.renderChatHistory();
    }

    renderChatHistory(filterText = '') {
        const chatList = document.getElementById('chatHistoryList');
        if (!chatList) return;
        
        chatList.innerHTML = '';

        // Filter chats based on search text
        const filteredChats = filterText 
            ? this.chats.filter(chat => 
                (chat.title || 'New Chat').toLowerCase().includes(filterText.toLowerCase()))
            : this.chats;

        // Show empty state if no chats
        if (filteredChats.length === 0) {
            const emptyState = document.createElement('div');
            emptyState.className = 'empty-state';
            emptyState.textContent = filterText ? 'No matching chats' : 'No chats yet';
            chatList.appendChild(emptyState);
            return;
        }

        filteredChats.forEach((chat) => {
            const item = document.createElement('div');
            item.className = 'chat-history-item' + (this.currentChatId === chat.id ? ' active' : '');
            
            const titleSpan = document.createElement('span');
            titleSpan.className = 'chat-title';
            titleSpan.textContent = chat.title || 'New Chat';
            titleSpan.onclick = (e) => {
                e.stopPropagation();
                this.loadChat(chat.id);
            };
            
            const deleteBtn = document.createElement('button');
            deleteBtn.className = 'chat-delete-btn';
            deleteBtn.innerHTML = '×';
            deleteBtn.title = 'Delete chat';
            deleteBtn.onclick = (e) => {
                e.stopPropagation();
                this.deleteChat(chat.id);
            };
            
            item.appendChild(titleSpan);
            item.appendChild(deleteBtn);
            item.onclick = () => this.loadChat(chat.id);
            chatList.appendChild(item);
        });
    }

    filterChats(searchText) {
        this.renderChatHistory(searchText);
    }

    startNewChat() {
        // Remove any empty chats with no messages before creating a new one
        this.chats = this.chats.filter(chat => chat.messages && chat.messages.length > 0);
        
        const chatId = Date.now().toString();
        this.currentChatId = chatId;
        this.uploadedFiles = [];
        this.chats.push({
            id: chatId,
            title: 'New Chat',
            messages: [],
            timestamp: new Date().toLocaleString()
        });
        this.saveChats();
        this.renderChatMessages();
    }

    loadChat(chatId) {
        const chat = this.chats.find(c => c.id === chatId);
        if (!chat) {
            console.error('Chat not found:', chatId);
            return;
        }
        this.currentChatId = chatId;
        this.uploadedFiles = [];
        this.renderChatMessages();
        this.renderChatHistory(); // Update active state
    }

    deleteChat(chatId) {
        if (this.chats.length <= 1) {
            this.showToast('Cannot delete the last chat', 'warning');
            return;
        }
        
        const index = this.chats.findIndex(c => c.id === chatId);
        if (index === -1) return;
        
        // If deleting the current chat, switch to another one
        if (this.currentChatId === chatId) {
            // Find another chat to switch to
            const otherChat = this.chats.find(c => c.id !== chatId);
            if (otherChat) {
                this.currentChatId = otherChat.id;
            } else {
                // Create a new chat if no other exists
                this.startNewChat();
                return; // startNewChat already removes the old one
            }
        }
        
        // Remove the chat
        this.chats.splice(index, 1);
        this.saveChats();
        this.renderChatMessages();
    }

    loadExample(example) {
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.value = example;
            messageInput.focus();
            messageInput.style.height = 'auto';
            messageInput.style.height = Math.min(messageInput.scrollHeight, 200) + 'px';
        }
    }

    handleFileSelect(event) {
        const files = Array.from(event.target.files);
        files.forEach(file => {
            this.uploadedFiles.push({
                name: file.name,
                size: file.size,
                file: file
            });
        });
        this.renderFileList();
        event.target.value = '';
    }

    renderFileList() {
        const fileList = document.getElementById('fileList');
        if (!fileList) return;
        
        fileList.innerHTML = '';

        this.uploadedFiles.forEach((fileObj, index) => {
            const item = document.createElement('div');
            item.className = 'file-item';
            const icon = this.getFileIcon(fileObj.name);
            item.innerHTML = `
                <span>${icon} ${fileObj.name}</span>
                <button class="file-item-remove" onclick="app.removeFile(${index})">×</button>
            `;
            fileList.appendChild(item);
        });
    }

    getFileIcon(fileName) {
        // Return empty string - no icons needed
        return '';
    }

    renderFileList() {
        const fileList = document.getElementById('fileList');
        if (!fileList) return;
        
        fileList.innerHTML = '';

        this.uploadedFiles.forEach((fileObj, index) => {
            const item = document.createElement('div');
            item.className = 'file-item';
            const icon = this.getFileIcon(fileObj.name);
            item.innerHTML = `
                <span>${this.getFileIcon(fileObj.name)} ${icon} ${fileObj.name}</span>
                <button class="file-item-remove" onclick="app.removeFile(${index})">×</button>
            `;
            fileList.appendChild(item);
        });
    }

    removeFile(index) {
        this.uploadedFiles.splice(index, 1);
        this.renderFileList();
    }

    /**
     * Preview a file structure
     */
    async previewFile(fileId) {
        try {
            const response = await fetch(`/api/storage/preview/${fileId}?user_id=default&rows=5`);
            const data = await response.json();
            
            if (data.success && data.preview) {
                // Show preview in modal or tooltip
                console.log('File preview:', data.preview);
                // TODO: Create preview modal UI
                return data.preview;
            }
        } catch (error) {
            console.error('Error previewing file:', error);
        }
        return null;
    }

    /**
     * Get storage statistics
     */
    async getStorageStats() {
        try {
            const response = await fetch('/api/storage/stats?user_id=default');
            const data = await response.json();
            
            if (data.success) {
                return data.stats;
            }
        } catch (error) {
            console.error('Error getting storage stats:', error);
        }
        return null;
    }

    /**
     * Download a file from the run results
     */
    async downloadFile(runId, fileName) {
        try {
            const fileUrl = `/api/run/${runId}/file/${encodeURIComponent(fileName)}`;
            
            // Fetch the file
            const response = await fetch(fileUrl);
            if (!response.ok) {
                throw new Error('Failed to download file');
            }
            
            // Get the blob
            const blob = await response.blob();
            
            // Create a download link
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            
            // Cleanup
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            
            this.showToast(`Downloaded ${fileName}`, 'success');
        } catch (error) {
            console.error('Error downloading file:', error);
            this.showToast(`Failed to download ${fileName}`, 'error');
        }
    }

    renderChatMessages() {
        const messagesContainer = document.getElementById('chatMessages');
        if (!messagesContainer) return;
        
        const currentChat = this.chats.find(c => c.id === this.currentChatId);

        if (!currentChat || currentChat.messages.length === 0) {
            messagesContainer.innerHTML = `
                <div class="chat-welcome">
                    <div class="welcome-content">
                        <h2>Welcome to Tahlil</h2>
                        <p>Your AI-powered data science analyst</p>
                    </div>
                </div>
            `;
            return;
        }

        messagesContainer.innerHTML = '';
        currentChat.messages.forEach((msg, index) => {
            const msgEl = document.createElement('div');
            msgEl.className = `message ${msg.role}`;
            msgEl.setAttribute('data-message-index', index);
            
            // Check if content is already HTML (contains HTML tags) or explicitly marked as HTML
            const isHtml = msg.isHtml || /<[a-z][\s\S]*>/i.test(msg.content);
            
            let content = msg.content;
            if (msg.role === 'assistant') {
                if (isHtml) {
                    // Content is already formatted HTML, use as-is
                    content = msg.content;
                } else if (typeof marked !== 'undefined') {
                    // Try to parse as markdown
                    try {
                        content = marked.parse(content);
                    } catch (e) {
                        content = this.escapeHtml(content);
                    }
                } else {
                    content = this.escapeHtml(content);
                }
            } else {
                // User messages: always escape HTML
                content = this.escapeHtml(content);
            }
            
            const contentDiv = document.createElement('div');
            contentDiv.className = 'message-content';
            if (msg.role === 'assistant' && !isHtml) {
                contentDiv.classList.add('markdown-content');
            }
            if (msg.hasImages) {
                contentDiv.classList.add('has-images');
            }
            contentDiv.innerHTML = content;
            msgEl.appendChild(contentDiv);
            
            // Add feedback UI for assistant messages that are not loading (below content)
            if (msg.role === 'assistant' && !msg.isLoading && !msg.content.includes('Error:')) {
                const feedbackDiv = this.createFeedbackUI(index, msg);
                msgEl.appendChild(feedbackDiv);
            }
            
            messagesContainer.appendChild(msgEl);
        });

        // Scroll to bottom
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    async sendMessage() {
        const messageInput = document.getElementById('messageInput');
        if (!messageInput) return;

        const message = messageInput.value.trim();

        // Validate early - need both message and files
        if (!message || !message.trim()) {
            this.showToast('Please enter a question or analysis request', 'warning');
            return;
        }

        if (!this.uploadedFiles || this.uploadedFiles.length === 0) {
            this.showToast('Please upload at least one data file to analyze', 'warning');
            return;
        }

        // Update chat title if it's the first message
        const currentChat = this.chats.find(c => c.id === this.currentChatId);
        if (!currentChat) {
            this.showToast('Error: Chat not found', 'error');
            return;
        }
        
        if (currentChat.messages.length === 0 && message) {
            currentChat.title = message.substring(0, 50);
        }

        // Store message before clearing input
        const userMessage = message;

        // Add user message to chat
        currentChat.messages.push({
            role: 'user',
            content: userMessage
        });

        // Clear input after storing message
        messageInput.value = '';
        messageInput.style.height = 'auto';
        this.renderChatMessages();
        this.saveChats();

        try {
            // Upload files first and get file IDs
            const uploadedFileIds = [];
            for (const fileObj of this.uploadedFiles) {
                try {
                    const formData = new FormData();
                    formData.append('file', fileObj.file);
                    formData.append('user_id', 'default'); // TODO: Get from user session
                    
                    const uploadResponse = await fetch('/api/data/upload', {
                        method: 'POST',
                        body: formData
                    });

                    if (!uploadResponse.ok) {
                        const errorData = await uploadResponse.json().catch(() => ({}));
                        throw new Error(errorData.error || `Failed to upload ${fileObj.name}`);
                    }

                    const uploadData = await uploadResponse.json();
                    if (uploadData.success) {
                        uploadedFileIds.push(uploadData.file.id);
                        if (uploadData.file.is_duplicate) {
                            this.showToast(`${fileObj.name} already exists (deduplicated)`, 'info');
                        }
                    } else {
                        throw new Error(uploadData.error || `Upload failed for ${fileObj.name}`);
                    }
                } catch (uploadError) {
                    console.error(`Error uploading ${fileObj.name}:`, uploadError);
                    throw uploadError;
                }
            }

            // Final validation (should not be needed since we validated earlier, but double-check silently)
            if (!uploadedFileIds.length) {
                // This should never happen if validation worked, but handle gracefully
                console.error('No files uploaded despite validation');
                // Remove the user message that was already added
                if (currentChat.messages.length > 0 && currentChat.messages[currentChat.messages.length - 1].role === 'user') {
                    currentChat.messages.pop();
                }
                this.renderChatMessages();
                this.saveChats();
                // Don't show notification again, already shown in early validation
                return;
            }

            if (!userMessage || !userMessage.trim()) {
                // This should never happen if validation worked, but handle gracefully
                console.error('No message provided despite validation');
                // Remove the user message that was already added
                if (currentChat.messages.length > 0 && currentChat.messages[currentChat.messages.length - 1].role === 'user') {
                    currentChat.messages.pop();
                }
                this.renderChatMessages();
                this.saveChats();
                // Don't show notification again, already shown in early validation
                return;
            }

            // Start analysis
            const response = await fetch('/api/run/start', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    query: userMessage,
                    file_ids: uploadedFileIds,  // Changed from 'files' to 'file_ids'
                    model: this.selectedModel,
                    max_refinement_rounds: 2,
                    user_id: 'default'  // TODO: Get from user session
                })
            });

            if (!response.ok) throw new Error('Analysis request failed');
            
            const data = await response.json();
            console.log('Run start response:', data); // Debug
            
            if (!data.success || !data.run_id) {
                throw new Error(data.error || 'No run_id returned');
            }
            
            this.activeRun = data.run_id;
            localStorage.setItem('activeRun', data.run_id);
            console.log('Active run set to:', this.activeRun); // Debug

            // Add loading message (stable, won't update during initial polls)
            currentChat.messages.push({
                role: 'assistant',
                content: 'Analyzing your data...',
                isLoading: true,
                lastStatusUpdate: null
            });
            this.renderChatMessages();

            // Show stop button, hide send button
            this.showStopButton();

            // Poll for results
            this.pollResults();

        } catch (error) {
            console.error('sendMessage error:', error); // Debug
            
            // Only show toast for actual errors, not validation warnings (those are handled earlier)
            const isValidationError = error.message.includes('Please enter') || 
                                     error.message.includes('Please upload') ||
                                     error.message.includes('Chat not found');
            
            if (!isValidationError) {
                this.showToast('Error: ' + error.message, 'error');
            }
            
            // Don't remove user message - keep it visible
            // Just add an error message from assistant
            const currentChat = this.chats.find(c => c.id === this.currentChatId);
            if (currentChat) {
                // Only add error message if it's not a validation error (those are handled by early returns)
                if (!isValidationError) {
                    currentChat.messages.push({
                        role: 'assistant',
                        content: `Error: ${error.message}. Please try again.`
                    });
                    this.renderChatMessages();
                }
            }
            this.saveChats();
        }
    }

    async pollResults() {
        let updateCount = 0;
        
        // Clear any existing poll interval
        if (this.pollInterval) {
            clearInterval(this.pollInterval);
        }
        
        this.pollInterval = setInterval(async () => {
            try {
                const response = await fetch(`/api/run/${this.activeRun}/status`);
                const data = await response.json();

                if (!data.success || !data.data) {
                    console.error('Invalid status response:', data);
                    return;
                }

                const status = data.data.status;
                console.log('Poll status:', status); // Debug

                if (['completed', 'failed', 'error', 'cancelled'].includes(status)) {
                    if (this.pollInterval) {
                        clearInterval(this.pollInterval);
                        this.pollInterval = null;
                    }

                    // Hide stop button, show send button
                    this.hideStopButton();

                    const currentChat = this.chats.find(c => c.id === this.currentChatId);
                    if (!currentChat) return;

                    // Remove loading message
                    if (currentChat.messages.length > 0 && 
                        currentChat.messages[currentChat.messages.length - 1].isLoading) {
                        currentChat.messages.pop();
                    }
                    
                    // If cancelled, add a message
                    if (status === 'cancelled') {
                        currentChat.messages.push({
                            role: 'assistant',
                            content: 'Analysis was cancelled.'
                        });
                    }

                    if (status === 'completed') {
                        // Fetch and display results
                        try {
                            const resultsResponse = await fetch(`/api/run/${this.activeRun}/results`);
                            const results = await resultsResponse.json();
                            
                            console.log('Results response:', results); // Debug
                            
                            if (results.success && results.results) {
                                let content = '';
                                
                                // Format text output in user-friendly way
                                if (results.results.output !== null && results.results.output !== undefined) {
                                    // Handle both string and object outputs
                                    const output = results.results.output;
                                    console.log('Output type:', typeof output, 'Output:', output); // Debug
                                    console.log('Full results object:', results.results); // Debug
                                    
                                    // First, try to format and structure the output
                                    const structuredOutput = this.preprocessOutput(output);
                                    
                                    // Then humanize technical parts
                                    const humanizedOutput = await this.humanizeOutput(structuredOutput);
                                    
                                    // Finally, format for display
                                    const formatted = this.formatUserFriendlyOutput(humanizedOutput);
                                    console.log('Formatted output:', formatted); // Debug
                                    if (formatted && formatted.trim()) {
                                        content += formatted;
                                    } else {
                                        // Fallback: show raw output if formatting fails
                                        content += `<div class="result-text">${this.escapeHtml(JSON.stringify(humanizedOutput, null, 2))}</div>`;
                                    }
                                } else {
                                    console.warn('No output in results:', results.results); // Debug
                                }
                                
                                // Display images/charts if available
                                if (results.results.files && results.results.files.length > 0) {
                                    console.log('Found files:', results.results.files); // Debug
                                    const imageHtml = this.createImageDisplay(results.results.files, this.activeRun);
                                    if (imageHtml) {
                                        content += imageHtml;
                                    }
                                }
                                
                                // If no content at all, show raw output as fallback
                                if (!content.trim()) {
                                    console.warn('No content generated from results'); // Debug
                                    // Try to show raw output as fallback
                                    if (results.results.output) {
                                        const rawOutput = typeof results.results.output === 'string' 
                                            ? results.results.output 
                                            : JSON.stringify(results.results.output, null, 2);
                                        content = `<div class="result-text"><pre>${this.escapeHtml(rawOutput)}</pre></div>`;
                                    } else {
                                        content = '<div class="result-text">Analysis completed successfully, but no results were returned. The analysis may have completed without generating output.</div>';
                                    }
                                }
                                
                                // Fetch steps for expandable process view
                                let stepsContent = '';
                                try {
                                    const stepsResponse = await fetch(`/api/run/${this.activeRun}/steps`);
                                    if (!stepsResponse.ok) {
                                        throw new Error(`HTTP ${stepsResponse.status}: ${stepsResponse.statusText}`);
                                    }
                                    const stepsData = await stepsResponse.json();
                                    console.log('Steps response:', stepsData); // Debug
                                    
                                    if (stepsData.success && stepsData.steps && Array.isArray(stepsData.steps) && stepsData.steps.length > 0) {
                                        stepsContent = this.createExpandableStepsView(stepsData.steps);
                                        console.log('Steps content generated, length:', stepsContent.length); // Debug
                                        console.log('Steps HTML preview:', stepsContent.substring(0, 200)); // Debug
                                    } else {
                                        console.warn('No steps found or steps array is empty. Steps data:', stepsData);
                                    }
                                } catch (stepsError) {
                                    console.error('Could not fetch steps:', stepsError);
                                    // Don't fail the whole result display if steps fail
                                }
                                
                                // Combine content and steps
                                const fullContent = content + (stepsContent ? stepsContent : '');
                                console.log('Full content length:', fullContent.length, 'Steps included:', stepsContent.length > 0); // Debug
                                
                                currentChat.messages.push({
                                    role: 'assistant',
                                    content: fullContent,
                                    hasImages: results.results.files && results.results.files.length > 0,
                                    hasSteps: stepsContent && stepsContent.length > 0,
                                    isHtml: true // Mark as HTML so it's not processed as markdown
                                });
                                this.renderChatMessages();
                                this.saveChats();
                                this.showToast('Analysis completed!', 'success');
                            } else {
                                console.error('Results not successful:', results); // Debug
                                currentChat.messages.push({
                                    role: 'assistant',
                                    content: 'Analysis completed. ' + (results.error ? 'Error: ' + results.error : 'No results available. Please check the run details.')
                                });
                            }
                        } catch (resultsError) {
                            console.error('Error fetching results:', resultsError);
                            currentChat.messages.push({
                                role: 'assistant',
                                content: 'Analysis completed but could not fetch results: ' + resultsError.message
                            });
                        }
                    } else {
                        currentChat.messages.push({
                            role: 'assistant',
                            content: `Analysis ${status}. Please try again.`
                        });
                        this.showToast(`Analysis ${status}`, 'error');
                    }

                    this.uploadedFiles = [];
                    this.renderFileList();
                    this.renderChatMessages();
                    this.saveChats();
                } else {
                    // Fetch progress to show current step
                    updateCount++;
                    const currentChat = this.chats.find(c => c.id === this.currentChatId);
                    
                    if (currentChat && currentChat.messages.length > 0) {
                        const lastMsg = currentChat.messages[currentChat.messages.length - 1];
                        if (lastMsg.isLoading) {
                            // Fetch progress information to show current step
                            // Only fetch every 3 polls (every 6 seconds) to reduce blinking and API calls
                            if (updateCount % 3 === 0) {
                                try {
                                    const progressResponse = await fetch(`/api/run/${this.activeRun}/progress`);
                                    const progressData = await progressResponse.json();
                                    
                                    if (progressData.success && progressData.data) {
                                        const progress = progressData.data;
                                        
                                        // Get current step identifier (more stable than just name)
                                        const currentStepId = this.getCurrentStepId(progress);
                                        const lastStepId = lastMsg.lastStepId || '';
                                        
                                        // Only update if step actually changed
                                        if (currentStepId && currentStepId !== lastStepId) {
                                            const currentStepMessage = this.getStepMessage(progress);
                                            
                                            if (currentStepMessage && currentStepMessage !== lastMsg.content) {
                                                // Update content and step ID atomically
                                                lastMsg.content = currentStepMessage;
                                                lastMsg.lastStepId = currentStepId;
                                                // Batch DOM update to prevent flickering
                                                if (!this.renderScheduled) {
                                                    this.renderScheduled = true;
                                                    requestAnimationFrame(() => {
                                                        this.renderChatMessages();
                                                        this.renderScheduled = false;
                                                    });
                                                }
                                            }
                                        }
                                    }
                                } catch (progressError) {
                                    // If progress fetch fails, keep current message
                                    // Silently fail to prevent error spam
                                }
                            }
                        }
                    }
                }
            } catch (error) {
                console.error('Poll error:', error);
            }
        }, 2000);
    }

    showSettings() {
        const modal = document.getElementById('settingsModal');
        if (modal) {
            modal.style.display = 'flex';
            // Update theme switcher in modal when opening
            const currentMode = localStorage.getItem('themeMode') || 'system';
            this.updateThemeSwitcher(currentMode);
        }
    }

    closeModal() {
        const modals = document.querySelectorAll('.modal');
        modals.forEach(m => m.style.display = 'none');
    }

    showToast(message, type = 'info') {
        const toast = document.getElementById('toast');
        if (!toast) return;

        toast.textContent = message;
        toast.className = `toast ${type}`;
        toast.style.display = 'block';

        setTimeout(() => {
            toast.style.display = 'none';
        }, 3000);
    }

    escapeHtml(text) {
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    /**
     * Format JSON/text output in a user-friendly way for non-technical users
     */
    formatUserFriendlyOutput(output) {
        // Handle null, undefined, or empty values
        if (output === null || output === undefined) {
            return '<div class="result-text">No results available.</div>';
        }
        
        // Handle empty strings
        if (typeof output === 'string' && output.trim() === '') {
            return '<div class="result-text">Analysis completed but returned no output.</div>';
        }

        // CRITICAL FIX: Filter out Python code blocks from output
        if (typeof output === 'string') {
            // Check if output contains Python code (not execution results)
            const codePatterns = [
                /^import\s+/m,
                /^def\s+\w+/m,
                /^class\s+\w+/m,
                /^if\s+__name__/m,
                /pd\.read_csv/m,
                /plt\./m
            ];
            
            // If it looks like code and doesn't have print output, it's probably code
            const looksLikeCode = codePatterns.some(pattern => pattern.test(output));
            const hasPrintOutput = output.includes('\n') && 
                                 !output.trim().startsWith('import') &&
                                 !output.trim().startsWith('def') &&
                                 !output.trim().startsWith('class');
            
            if (looksLikeCode && !hasPrintOutput) {
                // This is code, not execution output - show error message
                console.error('Output appears to be code instead of execution results');
                return '<div class="result-text">The analysis generated code but did not produce output. Please try rephrasing your question or check the process details for more information.</div>';
            }
            
            // Remove markdown code blocks if present (```python ... ```)
            output = output.replace(/```python\s*\n([\s\S]*?)\n```/g, '$1');
            output = output.replace(/```\s*\n([\s\S]*?)\n```/g, '$1');
        }

        // Try to parse as JSON if it's a string
        let parsed;
        if (typeof output === 'string') {
            // Check if it's already humanized (contains natural language, not just JSON)
            // If it looks like natural language with some structure, format it as text
            if (output.includes('.') && output.length > 50 && !output.trim().startsWith('{') && !output.trim().startsWith('[')) {
                // Likely already humanized or mixed text, format as plain text
                return this.formatPlainText(output);
            }
            
            try {
                parsed = JSON.parse(output);
            } catch (e) {
                // Not JSON, return as-is but formatted nicely
                return this.formatPlainText(output);
            }
        } else {
            parsed = output;
        }

        // Handle different JSON structures
        if (typeof parsed !== 'object' || parsed === null) {
            return this.formatPlainText(String(output));
        }

        // Check for common result structures
        if (parsed.final_answer) {
            return this.formatFinalAnswerSync(parsed.final_answer);
        }

        // If it's an array of objects (like employee records)
        if (Array.isArray(parsed)) {
            return this.formatArray(parsed);
        }

        // If it's an object with data
        if (typeof parsed === 'object') {
            return this.formatObject(parsed);
        }

        return this.formatPlainText(JSON.stringify(parsed, null, 2));
    }

    async     formatFinalAnswerSync(answer) {
        if (Array.isArray(answer)) {
            return this.formatArray(answer);
        } else if (typeof answer === 'object' && answer !== null) {
            return this.formatObject(answer);
        } else {
            return `<div class="result-text">${this.escapeHtml(String(answer))}</div>`;
        }
    }

    /**
     * Humanize technical data in output using AI
     * Handles mixed text and JSON by humanizing only the technical parts
     * For table requests, keeps table structure but humanizes explanations
     */
    async humanizeOutput(output) {
        // If output is a string that looks like it contains a table, 
        // extract table first, then humanize only the explanation part
        if (typeof output === 'string') {
            const tableMatch = this.detectAndExtractTable(output);
            if (tableMatch && tableMatch.explanation) {
                // Humanize only the explanation, keep table as-is
                try {
                    const humanizedExplanation = await this.humanizeData(tableMatch.explanation);
                    // Reconstruct output with humanized explanation
                    const lines = output.split('\n');
                    const tableEndIndex = lines.findIndex((line, idx) => {
                        // Find where explanation starts
                        return idx > 0 && /^(The|This|Above|Below|In|As|These|Those)/i.test(line.trim()) && 
                               line.trim().length > 20;
                    });
                    
                    if (tableEndIndex > 0) {
                        const tablePart = lines.slice(0, tableEndIndex).join('\n');
                        return tablePart + '\n\n' + humanizedExplanation;
                    }
                } catch (e) {
                    console.warn('Failed to humanize explanation separately:', e);
                }
            }
        }
        try {
            // If output is a string, try to find and extract JSON data
            if (typeof output === 'string') {
                // Try to parse the entire string as JSON first
                try {
                    const parsed = JSON.parse(output);
                    // If it's a pure JSON object/array, humanize it
                    if (typeof parsed === 'object') {
                        return await this.humanizeData(parsed);
                    }
                    return output;
                } catch (e) {
                    // Not pure JSON, might be mixed text and JSON
                    // Look for JSON array/object patterns in the string
                    // Use a more sophisticated pattern to find complete JSON structures
                    // Match JSON arrays and objects that are complete (balanced brackets)
                    const findJsonInString = (str) => {
                        const results = [];
                        let depth = 0;
                        let start = -1;
                        let inString = false;
                        let escapeNext = false;
                        let quoteChar = '';
                        
                        for (let i = 0; i < str.length; i++) {
                            const char = str[i];
                            
                            if (escapeNext) {
                                escapeNext = false;
                                continue;
                            }
                            
                            if (char === '\\') {
                                escapeNext = true;
                                continue;
                            }
                            
                            if (!inString && (char === '"' || char === "'")) {
                                inString = true;
                                quoteChar = char;
                                continue;
                            }
                            
                            if (inString && char === quoteChar) {
                                inString = false;
                                continue;
                            }
                            
                            if (!inString) {
                                if (char === '[' || char === '{') {
                                    if (depth === 0) start = i;
                                    depth++;
                                } else if (char === ']' || char === '}') {
                                    depth--;
                                    if (depth === 0 && start !== -1) {
                                        const jsonStr = str.substring(start, i + 1);
                                        try {
                                            JSON.parse(jsonStr);
                                            results.push({ start, end: i + 1, json: jsonStr });
                                        } catch (e) {
                                            // Not valid JSON
                                        }
                                        start = -1;
                                    }
                                }
                            }
                        }
                        return results;
                    };
                    
                    const jsonMatches = findJsonInString(output);
                    
                    if (jsonMatches.length > 0) {
                        // Process matches in reverse order to maintain indices
                        let humanized = output;
                        for (let i = jsonMatches.length - 1; i >= 0; i--) {
                            const match = jsonMatches[i];
                            try {
                                const jsonData = JSON.parse(match.json);
                                const humanizedData = await this.humanizeData(jsonData);
                                // Replace from end to start to maintain indices
                                humanized = humanized.substring(0, match.start) + 
                                           humanizedData + 
                                           humanized.substring(match.end);
                            } catch (parseError) {
                                // Skip if not valid JSON
                                continue;
                            }
                        }
                        return humanized;
                    }
                    
                    return output;
                }
            } else if (typeof output === 'object') {
                // Object or array - humanize it
                return await this.humanizeData(output);
            }
            
            return output;
        } catch (error) {
            console.error('Error humanizing output:', error);
            // Return original if humanization fails
            return output;
        }
    }

    /**
     * Humanize technical data using AI
     */
    async humanizeData(data) {
        try {
            const response = await fetch('/api/humanize', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    data: data,
                    context: 'This is data analysis results that need to be explained in simple, non-technical language.'
                })
            });

            const result = await response.json();
            
            if (result.success && result.humanized) {
                return result.humanized;
            } else {
                console.warn('Humanization failed, using original data');
                return data;
            }
        } catch (error) {
            console.error('Error calling humanize API:', error);
            // Return original data if API call fails
            return data;
        }
    }

    formatArray(items) {
        if (!Array.isArray(items) || items.length === 0) {
            return '<div class="result-text">No results found.</div>';
        }

        // Check if items are objects (like employee records)
        if (typeof items[0] === 'object' && items[0] !== null) {
            return this.formatTable(items);
        }

        // Simple list
        let html = '<div class="result-list"><ul>';
        items.forEach(item => {
            html += `<li>${this.escapeHtml(String(item))}</li>`;
        });
        html += '</ul></div>';
        return html;
    }

    formatTable(items) {
        if (!Array.isArray(items) || items.length === 0) return '';

        const keys = Object.keys(items[0]);
        let html = '<div class="result-table-container"><table class="result-table">';
        
        // Header
        html += '<thead><tr>';
        keys.forEach(key => {
            html += `<th>${this.formatKeyName(key)}</th>`;
        });
        html += '</tr></thead>';

        // Rows
        html += '<tbody>';
        items.forEach(item => {
            html += '<tr>';
            keys.forEach(key => {
                const value = item[key];
                html += `<td>${this.escapeHtml(String(value !== null && value !== undefined ? value : ''))}</td>`;
            });
            html += '</tr>';
        });
        html += '</tbody></table></div>';

        return html;
    }

    formatObject(obj) {
        if (!obj || typeof obj !== 'object') return '';

        // If it looks like a single record, format as a card
        const keys = Object.keys(obj);
        if (keys.length <= 5) {
            let html = '<div class="result-card">';
            keys.forEach(key => {
                const value = obj[key];
                html += `<div class="result-field">
                    <span class="result-label">${this.formatKeyName(key)}:</span>
                    <span class="result-value">${this.escapeHtml(String(value !== null && value !== undefined ? value : ''))}</span>
                </div>`;
            });
            html += '</div>';
            return html;
        }

        // For larger objects, use a table
        return this.formatTable([obj]);
    }

    formatPlainText(text) {
        if (!text) return '';
        
        // Try to detect if text contains a table (tab-separated, pipe-separated, or structured data)
        const tableMatch = this.detectAndExtractTable(text);
        if (tableMatch) {
            let html = '';
            // Add the table first
            html += tableMatch.tableHtml;
            // Add explanation below if exists
            if (tableMatch.explanation) {
                html += `<div class="result-text result-explanation">${this.escapeHtml(tableMatch.explanation)}</div>`;
            }
            return html;
        }
        
        // Preserve line breaks and format nicely
        const lines = text.split('\n').filter(line => line.trim());
        if (lines.length === 1) {
            return `<div class="result-text">${this.escapeHtml(text)}</div>`;
        }
        let html = '<div class="result-text">';
        lines.forEach(line => {
            html += `<div>${this.escapeHtml(line)}</div>`;
        });
        html += '</div>';
        return html;
    }

    /**
     * Detect and extract table from text output
     * Returns { tableHtml: string, explanation: string } or null
     */
    detectAndExtractTable(text) {
        const lines = text.split('\n').map(line => line.trim()).filter(line => line);
        if (lines.length < 2) return null;

        // Look for tab-separated or pipe-separated values
        let headerLine = null;
        let dataStartIndex = -1;
        let separator = null;

        // Check for tab-separated
        for (let i = 0; i < lines.length; i++) {
            if (lines[i].includes('\t') && lines[i].split('\t').length >= 2) {
                headerLine = i;
                separator = '\t';
                dataStartIndex = i + 1;
                break;
            }
        }

        // Check for pipe-separated if no tab found
        if (!headerLine) {
            for (let i = 0; i < lines.length; i++) {
                if (lines[i].includes('|') && lines[i].split('|').length >= 2) {
                    headerLine = i;
                    separator = '|';
                    dataStartIndex = i + 1;
                    break;
                }
            }
        }

        // Check for structured format like "Column1  Column2  Column3" (multiple spaces)
        if (!headerLine) {
            for (let i = 0; i < lines.length; i++) {
                const parts = lines[i].split(/\s{2,}/); // Split on 2+ spaces
                if (parts.length >= 2 && parts.every(p => p.trim().length > 0)) {
                    headerLine = i;
                    separator = /\s{2,}/;
                    dataStartIndex = i + 1;
                    break;
                }
            }
        }

        if (!headerLine || dataStartIndex < 0) return null;

        // Extract headers
        const headers = separator === /\s{2,}/ 
            ? lines[headerLine].split(separator).map(h => h.trim())
            : lines[headerLine].split(separator).map(h => h.trim()).filter(h => h);

        // Extract data rows
        const dataRows = [];
        for (let i = dataStartIndex; i < lines.length; i++) {
            // Stop if we hit an explanation line (usually starts with "The", "This", "Above", etc.)
            if (/^(The|This|Above|Below|In|As|These|Those)/i.test(lines[i]) && 
                lines[i].length > 20 && 
                !lines[i].includes(separator === '\t' ? '\t' : separator === '|' ? '|' : '  ')) {
                break;
            }
            
            const row = separator === /\s{2,}/
                ? lines[i].split(separator).map(c => c.trim())
                : lines[i].split(separator).map(c => c.trim()).filter(c => c);
            
            if (row.length === headers.length || row.length >= headers.length * 0.8) {
                dataRows.push(row);
            } else {
                // Might be explanation, stop here
                break;
            }
        }

        if (dataRows.length === 0) return null;

        // Build table HTML
        let tableHtml = '<div class="result-table-container"><table class="result-table">';
        
        // Header
        tableHtml += '<thead><tr>';
        headers.forEach(header => {
            tableHtml += `<th>${this.escapeHtml(header)}</th>`;
        });
        tableHtml += '</tr></thead>';

        // Rows
        tableHtml += '<tbody>';
        dataRows.forEach(row => {
            tableHtml += '<tr>';
            headers.forEach((_, idx) => {
                const value = row[idx] || '';
                tableHtml += `<td>${this.escapeHtml(value)}</td>`;
            });
            tableHtml += '</tr>';
        });
        tableHtml += '</tbody></table></div>';

        // Extract explanation (everything after the table)
        const explanationStart = dataStartIndex + dataRows.length;
        const explanation = lines.slice(explanationStart).join(' ').trim();
        
        return {
            tableHtml,
            explanation: explanation || null
        };
    }

    /**
     * Preprocess output to improve structure detection
     * Cleans up common Python output formats
     */
    preprocessOutput(output) {
        if (typeof output !== 'string') return output;
        
        // Remove common Python DataFrame print artifacts
        let cleaned = output
            // Remove DataFrame index markers
            .replace(/^\s*\d+\s+/gm, '')
            // Clean up pandas DataFrame separators
            .replace(/^Name:\s+[^\n]+\n/gm, '')
            .replace(/^dtype:\s+[^\n]+\n/gm, '')
            // Remove empty lines at start/end
            .trim();
        
        // Try to detect and clean pandas DataFrame output
        // Format: "   Column1  Column2\n0  Value1   Value2"
        if (/^\s+\w+.*\n\s*\d+\s+/.test(cleaned)) {
            // Remove leading spaces and row numbers
            cleaned = cleaned
                .split('\n')
                .map((line, idx) => {
                    if (idx === 0) {
                        // Header row - clean up
                        return line.trim().replace(/\s{2,}/g, '\t');
                    }
                    // Data rows - remove leading row number
                    return line.replace(/^\s*\d+\s+/, '').trim().replace(/\s{2,}/g, '\t');
                })
                .join('\n');
        }
        
        return cleaned;
    }

    formatKeyName(key) {
        // Convert snake_case and camelCase to readable format
        return key
            .replace(/_/g, ' ')
            .replace(/([A-Z])/g, ' $1')
            .replace(/^./, str => str.toUpperCase())
            .trim();
    }

    /**
     * Create feedback UI for assistant messages
     */
    createFeedbackUI(messageIndex, message) {
        const feedbackDiv = document.createElement('div');
        feedbackDiv.className = 'message-feedback';
        feedbackDiv.setAttribute('data-message-index', messageIndex);
        
        // Check if feedback already exists for this message
        const messageId = this.getMessageId(messageIndex);
        const existingFeedback = this.getFeedback(messageId);
        
        if (existingFeedback) {
            // Show subtle thank you message
            feedbackDiv.innerHTML = `
                <div class="feedback-thanks">
                    <span>Thank you</span>
                </div>
            `;
        } else {
            // Show minimal feedback buttons (icon only, no text)
            feedbackDiv.innerHTML = `
                <div class="feedback-buttons">
                    <button class="feedback-btn feedback-positive" onclick="window.app.submitFeedback(${messageIndex}, true)" title="Helpful">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 10v12M15 5.88V14h3.38c1.12 0 2.12-.75 2.38-1.83l1.24-4.66c.15-.58-.34-1.17-.94-1.17H15M7 10H2.12c-.58 0-1.17.34-1.17.94l.24 4.66c.15.58.75 1.12 1.83 1.12H7M7 10l4-4"/>
                        </svg>
                    </button>
                    <button class="feedback-btn feedback-negative" onclick="window.app.submitFeedback(${messageIndex}, false)" title="Not helpful">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 14V2M9 18.12V10H5.62c-1.12 0-2.12.75-2.38 1.83l-1.24 4.66c-.15.58.34 1.17.94 1.17H9M17 14h4.88c.58 0 1.17-.34 1.17-.94l-.24-4.66c-.15-.58-.75-1.12-1.83-1.12H17M17 14l-4 4"/>
                        </svg>
                    </button>
                </div>
            `;
        }
        
        return feedbackDiv;
    }

    /**
     * Get unique message ID for feedback tracking
     */
    getMessageId(messageIndex) {
        const currentChat = this.chats.find(c => c.id === this.currentChatId);
        if (!currentChat || !currentChat.messages[messageIndex]) {
            return null;
        }
        
        const message = currentChat.messages[messageIndex];
        // Create ID from chat ID, message index, and content hash
        const contentHash = this.simpleHash(message.content.substring(0, 100));
        return `${this.currentChatId}-${messageIndex}-${contentHash}`;
    }

    /**
     * Simple hash function for content
     */
    simpleHash(str) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash; // Convert to 32bit integer
        }
        return Math.abs(hash).toString(36);
    }

    /**
     * Submit feedback for a message
     */
    async submitFeedback(messageIndex, isHelpful) {
        const currentChat = this.chats.find(c => c.id === this.currentChatId);
        if (!currentChat || !currentChat.messages[messageIndex]) {
            return;
        }

        const message = currentChat.messages[messageIndex];
        const messageId = this.getMessageId(messageIndex);
        
        // Get user's query (the message before this one)
        const userQuery = messageIndex > 0 ? currentChat.messages[messageIndex - 1].content : '';
        
        // Create feedback object
        const feedback = {
            messageId: messageId,
            chatId: this.currentChatId,
            messageIndex: messageIndex,
            isHelpful: isHelpful,
            userQuery: userQuery,
            assistantResponse: message.content.substring(0, 500), // First 500 chars
            timestamp: new Date().toISOString(),
            runId: this.activeRun || null
        };

        // Store feedback
        this.saveFeedback(feedback);

        // Show feedback form if not helpful
        if (!isHelpful) {
            this.showFeedbackForm(messageIndex, feedback);
        } else {
            // Update UI to show thank you
            this.updateFeedbackUI(messageIndex, true);
            this.showToast('Thank you for your feedback!', 'success');
        }
    }

    /**
     * Show feedback form for detailed feedback
     */
    showFeedbackForm(messageIndex, feedback) {
        // Create modal for feedback form
        const modal = document.createElement('div');
        modal.className = 'feedback-modal';
        modal.innerHTML = `
            <div class="feedback-modal-content">
                <div class="feedback-modal-header">
                    <h3>Help us improve</h3>
                    <button class="feedback-modal-close" onclick="this.closest('.feedback-modal').remove()">×</button>
                </div>
                <div class="feedback-modal-body">
                    <p>What was the issue with this result?</p>
                    <textarea id="feedbackDetails" class="feedback-textarea" placeholder="Please describe what was wrong or what you expected instead..."></textarea>
                    <div class="feedback-options">
                        <label class="feedback-option">
                            <input type="checkbox" value="not-user-friendly" class="feedback-checkbox">
                            <span>Not user-friendly / Too technical</span>
                        </label>
                        <label class="feedback-option">
                            <input type="checkbox" value="incorrect-data" class="feedback-checkbox">
                            <span>Incorrect data or results</span>
                        </label>
                        <label class="feedback-option">
                            <input type="checkbox" value="missing-info" class="feedback-checkbox">
                            <span>Missing information</span>
                        </label>
                        <label class="feedback-option">
                            <input type="checkbox" value="format-issue" class="feedback-checkbox">
                            <span>Formatting issue (table, graph, etc.)</span>
                        </label>
                        <label class="feedback-option">
                            <input type="checkbox" value="other" class="feedback-checkbox">
                            <span>Other</span>
                        </label>
                    </div>
                </div>
                <div class="feedback-modal-footer">
                    <button class="feedback-submit-btn" onclick="window.app.submitDetailedFeedback(${messageIndex})">Submit Feedback</button>
                    <button class="feedback-cancel-btn" onclick="this.closest('.feedback-modal').remove()">Cancel</button>
                </div>
            </div>
        `;
        
        document.body.appendChild(modal);
        
        // Close on background click
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.remove();
            }
        });
    }

    /**
     * Submit detailed feedback
     */
    submitDetailedFeedback(messageIndex) {
        const textarea = document.getElementById('feedbackDetails');
        const checkboxes = document.querySelectorAll('.feedback-checkbox:checked');
        
        const issues = Array.from(checkboxes).map(cb => cb.value);
        const details = textarea.value.trim();
        
        const currentChat = this.chats.find(c => c.id === this.currentChatId);
        if (!currentChat || !currentChat.messages[messageIndex]) {
            return;
        }

        const message = currentChat.messages[messageIndex];
        const messageId = this.getMessageId(messageIndex);
        const userQuery = messageIndex > 0 ? currentChat.messages[messageIndex - 1].content : '';
        
        const feedback = {
            messageId: messageId,
            chatId: this.currentChatId,
            messageIndex: messageIndex,
            isHelpful: false,
            userQuery: userQuery,
            assistantResponse: message.content.substring(0, 500),
            timestamp: new Date().toISOString(),
            runId: this.activeRun || null,
            issues: issues,
            details: details
        };

        this.saveFeedback(feedback);
        
        // Close modal
        const modal = document.querySelector('.feedback-modal');
        if (modal) {
            modal.remove();
        }
        
        // Update UI
        this.updateFeedbackUI(messageIndex, false);
        this.showToast('Thank you for your detailed feedback!', 'success');
    }

    /**
     * Update feedback UI after submission
     */
    updateFeedbackUI(messageIndex, isHelpful) {
        const messageEl = document.querySelector(`.message[data-message-index="${messageIndex}"]`) ||
                         document.querySelectorAll('.message.assistant')[messageIndex];
        if (!messageEl) return;
        
        let feedbackDiv = messageEl.querySelector('.message-feedback');
        if (!feedbackDiv) {
            feedbackDiv = document.createElement('div');
            feedbackDiv.className = 'message-feedback';
            messageEl.appendChild(feedbackDiv);
        }
        
        feedbackDiv.innerHTML = `
            <div class="feedback-thanks">
                <span>✓ Thank you for your feedback!</span>
            </div>
        `;
    }

    /**
     * Save feedback to localStorage
     */
    saveFeedback(feedback) {
        try {
            let allFeedback = JSON.parse(localStorage.getItem('tahlil_feedback') || '[]');
            allFeedback.push(feedback);
            
            // Keep only last 1000 feedback entries
            if (allFeedback.length > 1000) {
                allFeedback = allFeedback.slice(-1000);
            }
            
            localStorage.setItem('tahlil_feedback', JSON.stringify(allFeedback));
            
            // Also try to send to backend if available
            this.sendFeedbackToBackend(feedback).catch(err => {
                console.warn('Failed to send feedback to backend:', err);
            });
        } catch (error) {
            console.error('Error saving feedback:', error);
        }
    }

    /**
     * Get feedback for a message
     */
    getFeedback(messageId) {
        try {
            const allFeedback = JSON.parse(localStorage.getItem('tahlil_feedback') || '[]');
            return allFeedback.find(f => f.messageId === messageId) || null;
        } catch (error) {
            console.error('Error getting feedback:', error);
            return null;
        }
    }

    /**
     * Send feedback to backend (optional)
     */
    async sendFeedbackToBackend(feedback) {
        try {
            // Try to send to backend if endpoint exists
            const response = await fetch('/api/feedback', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(feedback)
            });
            
            if (!response.ok) {
                throw new Error('Failed to send feedback');
            }
        } catch (error) {
            // Silently fail - feedback is stored locally anyway
            throw error;
        }
    }

    /**
     * Get all feedback (for admin/viewing purposes)
     */
    getAllFeedback() {
        try {
            return JSON.parse(localStorage.getItem('tahlil_feedback') || '[]');
        } catch (error) {
            console.error('Error getting all feedback:', error);
            return [];
        }
    }

    /**
     * Export feedback as JSON
     */
    exportFeedback() {
        const feedback = this.getAllFeedback();
        const dataStr = JSON.stringify(feedback, null, 2);
        const dataBlob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(dataBlob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `tahlil-feedback-${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }

    /**
     * Create HTML for displaying image/chart files
     */
    createImageDisplay(files, runId) {
        if (!files || !Array.isArray(files) || files.length === 0) {
            return '';
        }

        // Filter for image files
        const imageFiles = files.filter(file => {
            const ext = file.toLowerCase().split('.').pop();
            return ['png', 'jpg', 'jpeg', 'gif', 'svg', 'webp'].includes(ext);
        });

        // Filter for HTML files (like Plotly charts)
        const htmlFiles = files.filter(file => {
            const ext = file.toLowerCase().split('.').pop();
            return ext === 'html';
        });

        let html = '';

        // Display images
        if (imageFiles.length > 0) {
            html += '<div class="result-images">';
            imageFiles.forEach(file => {
                const imageUrl = `/api/run/${runId}/file/${encodeURIComponent(file)}`;
                html += `<div class="result-image-container">
                    <div class="result-image-header">
                        <span class="result-image-name">${this.escapeHtml(file)}</span>
                        <button class="result-download-btn" onclick="app.downloadFile('${runId}', '${this.escapeHtml(file)}')" title="Download ${this.escapeHtml(file)}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                        </button>
                    </div>
                    <img src="${imageUrl}" alt="${this.escapeHtml(file)}" class="result-image" loading="lazy">
                </div>`;
            });
            html += '</div>';
        }

        // Display HTML files (like Plotly charts) in iframes
        if (htmlFiles.length > 0) {
            html += '<div class="result-htmls">';
            htmlFiles.forEach(file => {
                const fileUrl = `/api/run/${runId}/file/${encodeURIComponent(file)}`;
                html += `<div class="result-html-container">
                    <div class="result-image-header">
                        <span class="result-image-name">${this.escapeHtml(file)}</span>
                        <button class="result-download-btn" onclick="app.downloadFile('${runId}', '${this.escapeHtml(file)}')" title="Download ${this.escapeHtml(file)}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                        </button>
                    </div>
                    <iframe src="${fileUrl}" class="result-html" frameborder="0"></iframe>
                </div>`;
            });
            html += '</div>';
        }

        return html;
    }

    /**
     * Create expandable steps view (like ChatGPT's sub-chat)
     */
    createExpandableStepsView(steps) {
        if (!steps || steps.length === 0) return '';

        const stepId = `steps-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
        
        let html = `<div class="process-steps-container" id="${stepId}">
            <button class="process-steps-toggle" onclick="window.app && window.app.toggleSteps('${stepId}')">
                <span class="process-steps-icon">▼</span>
                <span class="process-steps-label">Process details (${steps.length} steps)</span>
            </button>
            <div class="process-steps-content" style="display: none;">
                <div class="process-steps-list">`;

        steps.forEach((step, index) => {
            const stepType = step.metadata?.step_type || step.step_id?.split('_').pop() || 'unknown';
            const stepNumber = step.step_id?.split('_')[0] || (index + 1).toString().padStart(3, '0');
            const stepDetailId = `${stepId}-step-${index}`;
            
            html += `<div class="process-step">
                <div class="process-step-header" onclick="window.app && window.app.toggleStepDetail('${stepDetailId}')">
                    <span class="process-step-number">Step ${stepNumber}</span>
                    <span class="process-step-type">${this.formatStepType(stepType)}</span>
                    <span class="process-step-toggle">▼</span>
                </div>
                <div class="process-step-detail" id="${stepDetailId}" style="display: none;">
                    ${this.formatStepDetail(step, stepDetailId)}
                </div>
            </div>`;
        });

        html += `</div></div></div>`;
        return html;
    }

    formatStepType(stepType) {
        const types = {
            'analyzer': 'Data Analysis',
            'planner_init': 'Initial Planning',
            'planner_next': 'Planning',
            'coder': 'Code Generation',
            'verifier': 'Verification',
            'router': 'Routing',
            'debugger': 'Debugging',
            'finalizer': 'Finalization'
        };
        return types[stepType] || stepType.charAt(0).toUpperCase() + stepType.slice(1);
    }

    formatStepDetail(step, stepDetailId) {
        let html = '';
        
        // Metadata
        if (step.metadata) {
            html += `<div class="step-metadata">
                <div class="step-metadata-item">
                    <strong>Step ID:</strong> ${this.escapeHtml(step.step_id || 'N/A')}
                </div>`;
            if (step.metadata.timestamp) {
                html += `<div class="step-metadata-item">
                    <strong>Timestamp:</strong> ${new Date(step.metadata.timestamp).toLocaleString()}
                </div>`;
            }
            html += `</div>`;
        }

        // Prompt (collapsible)
        if (step.prompt) {
            const promptId = `${stepDetailId}-prompt`;
            html += `<div class="step-section">
                <div class="step-section-header" onclick="window.app && window.app.toggleStepSection('${promptId}')">
                    <span>Prompt</span>
                    <span class="step-section-toggle">▼</span>
                </div>
                <div class="step-section-content" id="${promptId}" style="display: none;">
                    <pre class="step-code">${this.escapeHtml(step.prompt)}</pre>
                </div>
            </div>`;
        }

        // Code (collapsible)
        if (step.code) {
            const codeId = `${stepDetailId}-code`;
            html += `<div class="step-section">
                <div class="step-section-header" onclick="window.app && window.app.toggleStepSection('${codeId}')">
                    <span>Generated Code</span>
                    <span class="step-section-toggle">▼</span>
                </div>
                <div class="step-section-content" id="${codeId}" style="display: none;">
                    <pre class="step-code"><code>${this.escapeHtml(step.code)}</code></pre>
                </div>
            </div>`;
        }

        // Result
        if (step.result) {
            const resultId = `${stepDetailId}-result`;
            html += `<div class="step-section">
                <div class="step-section-header" onclick="window.app && window.app.toggleStepSection('${resultId}')">
                    <span>Execution Result</span>
                    <span class="step-section-toggle">▼</span>
                </div>
                <div class="step-section-content" id="${resultId}" style="display: none;">
                    <pre class="step-result">${this.escapeHtml(step.result)}</pre>
                </div>
            </div>`;
        }

        return html;
    }

    toggleSteps(containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        
        const content = container.querySelector('.process-steps-content');
        const toggle = container.querySelector('.process-steps-toggle');
        const icon = toggle.querySelector('.process-steps-icon');
        
        if (content.style.display === 'none') {
            content.style.display = 'block';
            icon.textContent = '▲';
        } else {
            content.style.display = 'none';
            icon.textContent = '▼';
        }
    }

    toggleStepDetail(detailId) {
        const detail = document.getElementById(detailId);
        if (!detail) return;
        
        const header = detail.previousElementSibling;
        const toggle = header.querySelector('.process-step-toggle');
        
        if (detail.style.display === 'none') {
            detail.style.display = 'block';
            toggle.textContent = '▲';
        } else {
            detail.style.display = 'none';
            toggle.textContent = '▼';
        }
    }

    toggleStepSection(sectionId) {
        const section = document.getElementById(sectionId);
        if (!section) return;
        
        const header = section.previousElementSibling;
        const toggle = header.querySelector('.step-section-toggle');
        
        if (section.style.display === 'none') {
            section.style.display = 'block';
            toggle.textContent = '▲';
        } else {
            section.style.display = 'none';
            toggle.textContent = '▼';
        }
    }

    loadTheme() {
        // Check for saved theme preference or default to system
        const savedMode = localStorage.getItem('themeMode') || 'system';
        this.setThemeMode(savedMode);
    }

    setThemeMode(mode) {
        localStorage.setItem('themeMode', mode);
        
        let effectiveTheme;
        if (mode === 'system') {
            // Check system preference
            effectiveTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } else {
            effectiveTheme = mode;
        }
        
        this.applyTheme(effectiveTheme);
        this.updateThemeSwitcher(mode);
    }

    applyTheme(theme) {
        if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.removeAttribute('data-theme');
        }
    }

    updateThemeSwitcher(activeMode) {
        // Update the active state of theme buttons
        const themeOptions = document.querySelectorAll('.theme-option');
        themeOptions.forEach(option => {
            if (option.dataset.theme === activeMode) {
                option.classList.add('active');
            } else {
                option.classList.remove('active');
            }
        });
    }

    // Keep for backwards compatibility
    toggleTheme() {
        const currentMode = localStorage.getItem('themeMode') || 'system';
        const newMode = currentMode === 'dark' ? 'light' : 'dark';
        this.setThemeMode(newMode);
    }

    toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const tooltip = document.getElementById('toggleTooltip');
        if (!sidebar) return;
        
        const isMinimized = sidebar.classList.contains('minimized');
        if (isMinimized) {
            sidebar.classList.remove('minimized');
            localStorage.setItem('sidebarMinimized', 'false');
            if (tooltip) tooltip.textContent = 'Close sidebar';
        } else {
            sidebar.classList.add('minimized');
            localStorage.setItem('sidebarMinimized', 'true');
            if (tooltip) tooltip.textContent = 'Open sidebar';
        }
    }

    loadSidebarState() {
        const sidebar = document.getElementById('sidebar');
        const tooltip = document.getElementById('toggleTooltip');
        if (!sidebar) return;
        
        const savedState = localStorage.getItem('sidebarMinimized');
        if (savedState === 'true') {
            sidebar.classList.add('minimized');
            if (tooltip) tooltip.textContent = 'Open sidebar';
        } else {
            sidebar.classList.remove('minimized');
            if (tooltip) tooltip.textContent = 'Close sidebar';
        }
    }

    showStopButton() {
        const sendBtn = document.getElementById('sendBtn');
        const stopBtn = document.getElementById('stopBtn');
        if (sendBtn) sendBtn.style.display = 'none';
        if (stopBtn) stopBtn.style.display = 'flex';
    }

    hideStopButton() {
        const sendBtn = document.getElementById('sendBtn');
        const stopBtn = document.getElementById('stopBtn');
        if (sendBtn) sendBtn.style.display = 'flex';
        if (stopBtn) stopBtn.style.display = 'none';
    }

    /**
     * Get current step ID for change detection (more stable identifier)
     */
    getCurrentStepId(progress) {
        if (!progress || !progress.steps || progress.steps.length === 0) {
            return null;
        }

        // Get the last in-progress step, or the last step if all are completed
        const inProgressSteps = progress.steps.filter(s => s.status === 'in_progress');
        const currentStep = inProgressSteps.length > 0 
            ? inProgressSteps[inProgressSteps.length - 1] 
            : progress.steps[progress.steps.length - 1];

        if (!currentStep) {
            return null;
        }

        // Create a stable identifier using phase, name, and timestamp
        // This ensures we detect actual step changes, not just re-renders
        const stepName = (currentStep.name || '').toLowerCase();
        const phase = (currentStep.phase || '').toLowerCase();
        
        // Extract the core step type (remove variable parts like file names, round numbers)
        let coreStepType = stepName;
        if (stepName.includes('analyzing data file')) {
            coreStepType = 'analyzing_data';
        } else if (stepName.includes('planning initial')) {
            coreStepType = 'planning_initial';
        } else if (stepName.includes('planning refinement')) {
            coreStepType = 'planning_refinement';
        } else if (stepName.includes('generating code')) {
            coreStepType = 'generating_code';
        } else if (stepName.includes('executing')) {
            coreStepType = 'executing_code';
        } else if (stepName.includes('verifying')) {
            coreStepType = 'verifying';
        } else if (stepName.includes('routing')) {
            coreStepType = 'routing';
        } else if (stepName.includes('debugging')) {
            coreStepType = 'debugging';
        } else if (stepName.includes('finalizing')) {
            coreStepType = 'finalizing';
        }
        
        return `${phase}_${coreStepType}`;
    }

    /**
     * Get user-friendly message for current step
     */
    getStepMessage(progress) {
        if (!progress || !progress.steps || progress.steps.length === 0) {
            return 'Analyzing your data...';
        }

        // Get the last in-progress step, or the last step if all are completed
        const inProgressSteps = progress.steps.filter(s => s.status === 'in_progress');
        const currentStep = inProgressSteps.length > 0 
            ? inProgressSteps[inProgressSteps.length - 1] 
            : progress.steps[progress.steps.length - 1];

        if (!currentStep) {
            return 'Analyzing your data...';
        }

        const stepName = currentStep.name || '';
        const phase = currentStep.phase || '';

        // Map step names to user-friendly messages
        const stepMessages = {
            // Phase 1 - Data Analysis
            'Analyzing data file': 'Your data is being analyzed...',
            'analyzer': 'Your data is being analyzed...',
            
            // Phase 2 - Planning
            'Planning initial analysis strategy': 'Analysis being planned...',
            'Planning refinement round': 'Refining analysis plan...',
            'planner_init': 'Analysis being planned...',
            'planner_next': 'Refining analysis plan...',
            
            // Phase 2 - Code Generation
            'Generating code for': 'Coding...',
            'coder': 'Coding...',
            
            // Phase 2 - Execution
            'Executing generated code': 'Executing code...',
            'executing': 'Executing code...',
            
            // Phase 2 - Verification
            'Verifying results': 'Verifying results...',
            'verifier': 'Verifying results...',
            
            // Phase 2 - Routing
            'Routing (refinement round': 'Planning next steps...',
            'router': 'Planning next steps...',
            
            // Phase 2 - Debugging
            'Debugging code': 'Debugging code...',
            'debugger': 'Debugging code...',
            
            // Phase 3 - Finalization
            'Finalizing solution': 'Finalizing solution...',
            'finalizer': 'Finalizing solution...'
        };

        // Try to match step name
        for (const [key, message] of Object.entries(stepMessages)) {
            if (stepName.toLowerCase().includes(key.toLowerCase())) {
                return message;
            }
        }

        // Fallback based on phase
        if (phase === 'PHASE 1') {
            return 'Your data is being analyzed...';
        } else if (phase === 'PHASE 2') {
            return 'Processing your request...';
        } else if (phase === 'PHASE 3') {
            return 'Finalizing solution...';
        }

        // Default message
        return 'Analyzing your data...';
    }

    async cancelAnalysis() {
        if (!this.activeRun) {
            this.showToast('No active analysis to cancel', 'warning');
            return;
        }

        try {
            const response = await fetch(`/api/run/${this.activeRun}/cancel`, {
                method: 'POST'
            });

            const data = await response.json();

            if (data.success) {
                // Stop polling
                if (this.pollInterval) {
                    clearInterval(this.pollInterval);
                    this.pollInterval = null;
                }

                // Hide stop button, show send button
                this.hideStopButton();

                // Update UI
                const currentChat = this.chats.find(c => c.id === this.currentChatId);
                if (currentChat) {
                    // Remove loading message
                    if (currentChat.messages.length > 0 && 
                        currentChat.messages[currentChat.messages.length - 1].isLoading) {
                        currentChat.messages.pop();
                    }
                    
                    // Add cancellation message
                    currentChat.messages.push({
                        role: 'assistant',
                        content: 'Analysis cancelled by user.'
                    });
                    
                    this.renderChatMessages();
                    this.saveChats();
                }

                this.showToast('Analysis cancelled', 'info');
                this.activeRun = null;
            } else {
                this.showToast('Failed to cancel: ' + (data.error || 'Unknown error'), 'error');
            }
        } catch (error) {
            console.error('Error cancelling analysis:', error);
            this.showToast('Error cancelling analysis: ' + error.message, 'error');
        }
    }
}

// Initialize app when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        window.app = new TahlilApp();
    });
} else {
    window.app = new TahlilApp();
}
